{
  "name": "mentoring-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "check": "pnpm -r typecheck && pnpm -r lint && pnpm depcruise",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "depcruise": "depcruise --validate .dependency-cruiser.cjs apps packages",
    "db:migrate": "pnpm --filter @mentoring/server db:migrate",
    "db:seed": "pnpm --filter @mentoring/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "dependency-cruiser": "^16.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
