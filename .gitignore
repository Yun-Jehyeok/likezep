node_modules/
dist/
.env
package-lock.json
*.env.local
.pnpm-store/

# TypeScript 빌드 캐시
*.tsbuildinfo

# 로그
*.log
_*.log

# Claude Code — 하네스 설정만 추적 (저장소가 공개라 범위를 좁게, 결정 로그 2026-11-23)
# 로컬 전용: settings.local.json, commands/, logs/, worktrees/, agent-memory-local/
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/hooks/
!.claude/rules/
!.claude/skills/
!.claude/agent-memory/

# 문서 (README.md와 위 하네스 문서만 예외. docs/는 로컬 전용)
docs/
*.md
!/README.md
!.claude/agents/**/*.md
!.claude/rules/**/*.md
!.claude/skills/**/*.md
!.claude/agent-memory/**/*.md

# Prisma
prisma/migrations/*.sql.bak

# Playwright
playwright-report/
test-results/
e2e-report/
e2e-debug-*.png

# infra 시크릿 (예시 파일만 커밋, 실제 conf는 서버에서만 관리)
infra/coturn/turnserver.conf

# IDE
.vscode/
.idea/

# 로컬 에셋/캡처 (git 추적 불필요)
/assets/
captures/

# 임시 E2E 테스트 (test-feature 스킬 생성)
e2e/ad-hoc/

# Playwright MCP 자동 생성 파일
.playwright-mcp/

# work/ 자동 생성 파일 (스크린샷·로그)
work/*.png
work/*.log
work/tasks/*/screenshots/
# 로컬 백업 (settings.local.json 등 자격 증명이 섞일 수 있음 — 커밋 금지)
work/archive/

# Module Federation 자동 생성 진단 파일
**/.mf/

# 성능 측정 세션 (JWT 포함 — 절대 커밋 금지)
perf/.auth/
