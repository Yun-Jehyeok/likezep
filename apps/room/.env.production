# 프로덕션 빌드 환경변수 (S3+CloudFront 이관 후 사용)
# 실제 값은 GH Actions secrets 또는 로컬 .env로 덮어쓴다.
# Vite는 VITE_* prefix env를 빌드 타임에 번들에 삽입한다.

# API + Colyseus WebSocket 엔드포인트 (이관 후 서브도메인 분할)
VITE_API_URL=https://api.like-zep.shop
VITE_SERVER_URL=wss://api.like-zep.shop

# Google OAuth (공개값 — 브라우저 번들에 포함됨)
VITE_GOOGLE_CLIENT_ID=

# Sentry (공개 DSN)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
