# 서버 포트 (Colyseus + Express 공용)
PORT=2567

# PostgreSQL (docker-compose.dev.yml 기준)
DATABASE_URL="postgresql://dev:dev@localhost:5432/mentoring"

# JWT 시크릿 (32자 이상 랜덤 문자열 권장)
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID
# 승인된 JavaScript 출처: http://localhost:5173
# 승인된 리디렉션 URI: postmessage (popup 방식이므로 URI 불필요)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 최초 로그인 시 admin 역할을 자동 부여할 이메일
ADMIN_EMAIL=your@gmail.com

# coturn TURN 서버 (로컬 개발 시 생략 가능)
# TURN_SECRET=
# TURN_HOST=

# mediasoup (EC2 배포 시에만 필요)
# MEDIASOUP_ANNOUNCED_IP=

# Sentry (선택, 없으면 에러 트래킹 비활성)
SENTRY_DSN=
SENTRY_RELEASE=
